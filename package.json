{
  "name": "kigumi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "format": "prettier --write src tests vite.config.ts README.md package.json tsconfig.json src-tauri/tauri.conf.json",
    "format:check": "prettier --check src tests vite.config.ts README.md package.json tsconfig.json src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/three": "^0.180.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
